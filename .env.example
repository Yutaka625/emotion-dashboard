# KSDV 環境変数のサンプル。
# このファイルをコピーして「.env」を作成し、実際のキーを記入してください（.env はGit管理外）。

# ── AIインサイト機能（有償・任意）の設定 ──
# APIキーはサーバ側でのみ使用し、クライアントには露出しません。

# 使用するLLMプロバイダ: gemini（既定） または anthropic
# 未指定の場合は gemini が使われます。
KSDV_AI_PROVIDER=gemini

# 既定プロバイダ（Gemini）のAPIキー。https://aistudio.google.com/apikey で発行できます。
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 代替プロバイダ（Anthropic Claude）のAPIキー。
# KSDV_AI_PROVIDER=anthropic のときに使用します。https://console.anthropic.com/ で発行できます。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
